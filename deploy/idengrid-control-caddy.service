[Unit]
Description=IdenGrid HTTPS gateway
After=network-online.target idengrid-control.service
Wants=network-online.target
Requires=idengrid-control.service

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/opt/idengrid
EnvironmentFile=/etc/idengrid/caddy.env
ExecStart=/usr/bin/caddy run --config /opt/idengrid/deploy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /opt/idengrid/deploy/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy /var/log/caddy

[Install]
WantedBy=multi-user.target
