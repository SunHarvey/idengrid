{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:idengrid:windows-edge:runtime-manifest:1",
  "title": "IdenGrid Windows Edge runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "architecture",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform": {
      "const": "windows"
    },
    "architecture": {
      "const": "x86_64"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "version",
          "filename",
          "url",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "cpython",
              "wheel",
              "caddy",
              "winsw"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.+-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
