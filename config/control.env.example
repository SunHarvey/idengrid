IDENGRID_ENV=production
DATABASE_URL='mysql+pymysql://idengrid:replace-me@mysql.example.internal:3306/idengrid'
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
DATA_DIR=/var/lib/idengrid
HOST=127.0.0.1
PORT=8000
IDENGRID_APP_DOMAIN=api.example.com
IDENGRID_API_PORT=8000
PUBLIC_ORIGIN=https://api.example.com
COOKIE_SECURE=true
CLOUD_VIDEO_ENABLED=false
ADMIN_SSH_PUBLIC_KEY_FILE=/etc/idengrid/admin-ssh.pub
# Optional one-time seed files for a new empty database:
# IDENGRID_BOOTSTRAP_FILE=/etc/idengrid/bootstrap.json
# IDENGRID_LOCAL_ENVIRONMENT_FILE=/etc/idengrid/local-environment.json
