<Window x:Class="IdenGrid.Windows.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IdenGrid 澜序" Width="1060" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrandNavyBrush}">
    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" Fill="#18315CFF" Canvas.Right="-180" Canvas.Top="-250" />
            <Ellipse Width="360" Height="360" Fill="#1828C7B7" Canvas.Left="-150" Canvas.Bottom="-170" />
        </Canvas>

        <Border x:Name="LoginPanel" Width="460" Padding="36,30" Background="White"
                CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <Border Width="82" Height="82" CornerRadius="18" Background="{StaticResource BrandBlueBrush}"
                        HorizontalAlignment="Center">
                    <Image Source="Assets/idengrid-64.png" Width="72" Height="72" Stretch="Uniform" />
                </Border>
                <TextBlock Text="澜序" Foreground="{StaticResource BrandInkBrush}" FontSize="34"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="IDENGRID CLOUD BROWSER" Foreground="{StaticResource BrandBlueBrush}"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="环境独立，协作从容" Foreground="{StaticResource BrandSlateBrush}"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,20" />

                <TextBlock Text="用户名" Foreground="{StaticResource BrandInkBrush}" FontSize="14" Margin="0,0,0,5" />
                <TextBox x:Name="UsernameBox" Height="40" FontSize="16" Padding="10,6" />
                <TextBlock Text="密码" Foreground="{StaticResource BrandInkBrush}" FontSize="14" Margin="0,14,0,5" />
                <Grid Height="40">
                    <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="10,6,46,6" />
                    <TextBox x:Name="VisiblePasswordBox" FontSize="16" Padding="10,6,46,6"
                             Visibility="Collapsed" />
                    <Button x:Name="PasswordVisibilityButton" Width="40" Height="38"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="TogglePasswordVisibility"
                            AutomationProperties.Name="显示密码" ToolTip="显示密码">
                        <Viewbox Width="22" Height="16">
                            <Grid Width="24" Height="16">
                                <Path Data="M1,8 C4,3 8,1 12,1 C16,1 20,3 23,8 C20,13 16,15 12,15 C8,15 4,13 1,8 Z"
                                      Fill="Transparent" Stroke="#66738B" StrokeThickness="1.7" />
                                <Ellipse Width="6" Height="6" Stroke="#66738B" StrokeThickness="1.7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="PasswordSlash" Data="M3,1 L21,15" Stroke="#66738B"
                                      StrokeThickness="2" Visibility="Collapsed" />
                            </Grid>
                        </Viewbox>
                    </Button>
                </Grid>
                <Button x:Name="LoginButton" Content="登录" Height="46" Margin="0,20,0,0"
                        Style="{StaticResource PrimaryButton}" Click="LoginClick" IsDefault="True" />
                <TextBlock x:Name="StatusText" Text="Windows客户端开发构建"
                           Foreground="{StaticResource BrandSlateBrush}" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <Button Content="退出应用" Click="ExitApplication" HorizontalAlignment="Center"
                        Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                        Foreground="{StaticResource BrandSlateBrush}" Cursor="Hand" />
            </StackPanel>
        </Border>

        <Grid x:Name="StorePanel" Visibility="Collapsed" Background="#F4F7FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource BrandNavyBrush}" Margin="0" Height="92">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="28,16" Orientation="Horizontal">
                    <Border Width="50" Height="50" CornerRadius="10" Background="White" Margin="0,0,14,0">
                        <Image Source="Assets/idengrid-64.png" Width="42" Height="42" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IdenGrid" Foreground="White" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="云端店铺工作空间" Foreground="#B8C2D9" FontSize="14" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Button Content="刷新" Click="RefreshClick" Padding="16,8" Margin="0,0,8,0" />
                    <Button Content="退出全部" Click="QuitAllClick" Padding="16,8" Margin="0,0,8,0" />
                    <Button Content="退出登录" Click="LogoutClick" Padding="16,8" Margin="0,0,8,0" />
                    <Button Content="退出应用" Click="ExitApplication" Padding="16,8" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="24,20,24,10">
                <TextBox x:Name="SearchBox" Height="42" Padding="44,7,12,7" FontSize="16"
                         TextChanged="SearchChanged" ToolTip="搜索店铺" />
                <TextBlock Text="⌕" FontSize="25" Foreground="{StaticResource BrandBlueBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                           IsHitTestVisible="False" />
            </Grid>
            <ListView x:Name="StoreList" Grid.Row="2" Margin="24,8" BorderThickness="0"
                      Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Margin="0,0,0,10" Padding="18,14">
                            <Grid Width="930" MinHeight="82">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BrandAquaBrush}" CornerRadius="4" />
                                <Ellipse Grid.Column="1" Width="12" Height="12" Fill="{Binding StateColor}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Margin="10,0">
                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold"
                                               Foreground="{StaticResource BrandInkBrush}" />
                                    <TextBlock Text="{Binding NodeLine}" FontSize="15" Margin="0,6,0,0"
                                               Foreground="{StaticResource BrandSlateBrush}" />
                                    <TextBlock Text="{Binding StatusLine}" FontSize="14" Margin="0,4,0,0"
                                               Foreground="{StaticResource BrandSlateBrush}" />
                                    <TextBlock Text="{Binding LocalLatencyLine}" FontSize="14" Margin="0,4,0,0"
                                               Foreground="{StaticResource BrandSlateBrush}" />
                                    <TextBlock Text="{Binding StateLine}" FontSize="15" FontWeight="SemiBold"
                                               Margin="0,4,0,0" Foreground="{StaticResource BrandBlueBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding LaunchButtonText}" IsEnabled="{Binding IsLaunchEnabled}"
                                            Click="StorePrimaryClick" Padding="22,10" Margin="0,0,8,0" />
                                    <Button Content="关闭" IsEnabled="{Binding IsCloseEnabled}"
                                            Click="StoreCloseClick" Padding="18,10" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="WorkspaceStatus" Grid.Row="3" Margin="28,8,28,18"
                       Foreground="{StaticResource BrandSlateBrush}" />
        </Grid>
    </Grid>
</Window>
