<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagerSource Condition="'$(ManagerSource)' == ''">../../src/IdenGrid.Windows.Wpf/WindowsStoreProcessManager.cs</ManagerSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/IdenGrid.Core/IdenGrid.Core.csproj" />
    <Compile Include="$(ManagerSource)" Link="WindowsStoreProcessManager.cs" />
  </ItemGroup>
</Project>
